# Hardware profile: rented RTX 5090 (32 GB, desktop/server CPU). Sourced by start_scope.sh only with
# `--hw 5090` or HW_PROFILE=5090. Without the flag the laptop (5080) path runs exactly as before and never reads this
# file. Every value here can still be overridden from the environment.
# Measurements behind the presets: experiments/2026-11-20-ll1-5090/FINDINGS.md

# CPU: no E-core pinning, no laptop thermal limits on the compile/OMP thread counts
export PIN_CPUS="${PIN_CPUS-}"
export OMP_NUM_THREADS="${HW_OMP_THREADS:-16}" MKL_NUM_THREADS="${HW_OMP_THREADS:-16}"
export TORCHINDUCTOR_COMPILE_THREADS="${HW_COMPILE_THREADS:-16}"
# hybrid-graphics (PRIME) variables are laptop-only
unset __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME
# The laptop's thermal watchdog reads CPU sensors and laptop limits; not for a datacenter box
export THERMAL_WATCHDOG="${THERMAL_WATCHDOG:-0}"
# No laptop power/battery warning or v4l2loopback camera device (headless box; output goes over the network)
export HW_LAPTOP_CHECKS="${HW_LAPTOP_CHECKS:-0}"
# Bridge: 5090 preset table + generation size (scope_bridge.py --hw 5090)
export HW_BRIDGE_ARGS="--hw 5090"
# Refuse to start on a smaller GPU (832x480 / 768x432 need more than 16 GB)
export HW_MIN_GPU_MB=30000
